---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Photo from '../../components/Photo.astro';
import SignedCopyDialog from '../../components/SignedCopyDialog.astro';
import { url, image, socialLinks } from '../../lib/utils';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

const { book } = Astro.props;
const d = book.data;
const { Content } = await render(book);
const authors = (await getEntries(d.authors.map((id) => ({ collection: 'authors' as const, id }))))
  .filter(Boolean); // keeps the order given in the book file (same as on the cover)
const reviews = await Promise.all(
  (await getCollection('reviews', (r) => r.data.book === book.id))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (r) => ({ r, Full: r.data.showFull ? (await render(r)).Content : null })),
);
const art = d.art ? image('books', d.art) : null;
const isNoir = d.theme === 'noir-gold';
const follow = socialLinks(d.social);

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Book', name: d.title, alternateName: d.subtitle,
  author: authors.map((a) => ({ '@type': 'Person', name: a.data.name })),
  image: new URL(url(`/images/books/${d.cover}`), Astro.site).toString(),
  inLanguage: 'en', ...(d.isbn ? { isbn: d.isbn } : {}),
  offers: d.buy.map((b) => ({ '@type': 'Offer', url: b.url, availability: 'https://schema.org/InStock' })),
};
---
<Base title={d.title} description={`${d.title}: ${d.subtitle}. ${d.hook}`} theme={d.theme} ogImage={`/images/books/${d.cover}`} jsonLd={jsonLd}>
  <section class="hero">
    {isNoir && (
      <svg class="wave" viewBox="0 0 1200 220" preserveAspectRatio="none" aria-hidden="true">
        <g fill="none" stroke="#C9A54C" stroke-width="1">
          <path d="M0,120 C200,40 340,190 560,110 S900,30 1200,120" />
          <path d="M0,130 C220,60 360,200 580,120 S920,50 1200,128" opacity=".7" />
          <path d="M0,112 C180,30 330,170 540,100 S880,20 1200,110" opacity=".5" />
          <path d="M0,140 C240,80 380,210 600,130 S940,70 1200,138" opacity=".35" />
        </g>
      </svg>
    )}
    {art && <img class="art" src={art.src} alt="" aria-hidden="true" />}
    <div class="wrap hero-grid">
      <Cover file={d.cover} alt={`${d.title} book cover`} class="cover" eager />
      <div>
        <div class="cat">{d.category}</div>
        <h1 class="book-title">{d.title}</h1>
        <div class={isNoir ? 'subtitle-caps' : 'sub'}>{d.subtitle}</div>
        {isNoir && d.tagline && <div class="tag">{d.tagline}.</div>}
        {!isNoir && <div class="by">{authors.map((a) => a.data.name).join(' · ')}</div>}
        <div class="buy-label">Buy the book</div>
        <div class="btn-row">
          {d.buy.map((b, i) => <a class={`btn ${i === 0 ? 'primary' : ''}`} href={b.url} target="_blank" rel="noopener">{b.label}</a>)}
        </div>
        {d.signedCopies && (
          <div class="signed">
            <button type="button" class="signed-btn" data-open-signed>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 21c3-1 5-3 7-6l7-7a2.1 2.1 0 0 0-3-3l-7 7c-3 2-5 4-6 7z"/><path d="M14 21h7"/></svg>
              Order a signed copy
            </button>
            <span class="signed-note">Signed by the author{authors.length > 1 ? 's' : ''}, delivered in India</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="block"><div class="wrap two">
    <div class="prose"><h2 class="h2">About the book</h2><Content /></div>
    <div><h2 class="h2">{d.discover.title}</h2><ul class="dash-list">{d.discover.items.map((i) => <li>{i}</li>)}</ul></div>
  </div></section>

  {d.quote && (
    <section class="block"><div class="wrap">
      <p class="pull">“{d.quote}”</p>
      <div class="orn"><i></i></div>
    </div></section>
  )}

  {d.feature && (
    <section class={`block ${d.feature.style === 'cards' ? 'center' : ''}`}><div class="wrap">
      <h2 class="h2">{d.feature.title}</h2>
      {d.feature.intro && <p class="muted intro">{d.feature.intro}</p>}
      {d.feature.style === 'compact' ? (
        <div class="compact">
          {d.feature.items.map((it, i) => <div><span>{String(i + 1).padStart(2, '0')}</span>{it.title}</div>)}
        </div>
      ) : (
        <div class="cards">
          {d.feature.items.map((it, i) => <div class="card"><div class="n">{i + 1}</div><h3>{it.title}</h3>{it.text && <p>{it.text}</p>}</div>)}
        </div>
      )}
      {d.feature.note && <p class="muted note">{d.feature.note}</p>}
    </div></section>
  )}

  {d.resources.length > 0 && (
    <section class="block"><div class="wrap">
      {d.resources.map((r) => (
        <div class="resource">
          <div><h3>{r.title}</h3><p>{r.text}</p></div>
          <a class="btn primary" href={r.url} target="_blank" rel="noopener">{r.label}</a>
        </div>
      ))}
    </div></section>
  )}

  {reviews.length > 0 && (
    <section class="block"><div class="wrap">
      <h2 class="h2">What readers say</h2>
      <div class="quotes">
        {reviews.map(({ r, Full }) => (
          <figure class="quote">
            {r.data.rating && <div class="stars" aria-label={`${r.data.rating} out of 5 stars`}>{'★'.repeat(r.data.rating)}{'☆'.repeat(5 - r.data.rating)}</div>}
            {r.data.title && <div class="r-title">{r.data.title}</div>}
            <blockquote>“{r.data.quote}”</blockquote>
            <figcaption>
              — {r.data.name}
              <span class="r-meta">
                {[r.data.verified && 'Verified purchase', r.data.source, r.data.date].filter(Boolean).join(' · ')}
              </span>
              {r.data.url && <a class="r-link" href={r.data.url} target="_blank" rel="noopener">Read on {r.data.source} →</a>}
            </figcaption>
            {Full && <details class="r-full"><summary>Read the full review</summary><div class="prose"><Full /></div></details>}
          </figure>
        ))}
      </div>
    </div></section>
  )}

  <section class="block"><div class="wrap">
    <h2 class="h2">{authors.length > 1 ? 'The authors' : 'About the author'}</h2>
    <div class="authors">
      {authors.map((a) => (
        <div class="author">
          <Photo file={a.data.photo} alt={a.data.name} initials={a.data.initials} class="author-photo" />
          <div>
            <h3>{a.data.name}</h3>
            <p class="muted">{a.data.short}</p>
            <a class="more" href={url(`/about#${a.id}`)}>More about {a.data.name.split(' ')[0]} →</a>
          </div>
        </div>
      ))}
    </div>
  </div></section>

  {d.faq.length > 0 && (
    <section class="block"><div class="wrap narrow">
      <h2 class="h2">Reader questions</h2>
      {d.faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      <p class="muted ask">Have a question about the book? <a href={url('/contact?reason=question')}>Ask it here</a>. The best ones get added to this page.</p>
    </div></section>
  )}

  {follow.length > 0 && (
    <section class="follow"><div class="wrap">
      <span class="follow-label">Follow {d.title}</span>
      <div class="follow-links">
        {follow.map((s) => <a class="btn" href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </div>
    </div></section>
  )}

  {d.disclaimer && <div class="fine"><p>{d.disclaimer}</p></div>}

  {d.signedCopies && <SignedCopyDialog bookTitle={d.title} />}
</Base>

<style>
  .hero { position: relative; overflow: hidden; }
  .wave { position: absolute; left: 0; right: 0; top: 50%; width: 100%; height: 220px; transform: translateY(-50%); opacity: .35; pointer-events: none; }
  .art { position: absolute; right: -40px; bottom: -10px; width: 640px; opacity: .3; mix-blend-mode: multiply; pointer-events: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: 320px 1fr; gap: 64px; align-items: center; padding-top: 80px; padding-bottom: 88px; }
  :global(.cover) { width: 100%; box-shadow: 0 28px 64px rgba(0,0,0,.45); }
  .t-noir-gold :global(.cover) { box-shadow: 0 30px 70px rgba(0,0,0,.7), 0 0 0 1px rgba(201,165,76,.25); }
  .t-ivory-ink :global(.cover) { box-shadow: 0 26px 60px rgba(60,40,20,.25); }
  .book-title { margin: 14px 0 10px; }
  .subtitle-caps { font-size: 14px; letter-spacing: .18em; text-transform: uppercase; color: var(--t-soft); }
  .tag { font: italic 400 24px var(--f-title); margin: 22px 0 30px; }
  .by { font-size: 13px; letter-spacing: .24em; text-transform: uppercase; color: var(--t-soft); margin: 22px 0 30px; }
  .buy-label { font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--t-soft); margin-bottom: 12px; }
  .t-ivory-ink .btn:not(.primary) { background: rgba(255,255,255,.6); }
  .signed { margin-top: 22px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .signed-btn {
    display: inline-flex; align-items: center; gap: 9px; background: none; border: 0; padding: 4px 0;
    font: 500 15px var(--f-body); color: var(--t-accent); cursor: pointer;
    border-bottom: 1.5px solid currentColor;
  }
  .signed-btn:hover { opacity: .8; }
  .signed-note { font-size: 13px; color: var(--t-soft); }

  .pull { font: italic 400 clamp(26px, 3.4vw, 36px)/1.35 var(--f-title); max-width: 720px; margin: 0 auto; text-align: center; }
  .orn { display: flex; align-items: center; justify-content: center; gap: 12px; margin: 22px auto 0; }
  .orn::before, .orn::after { content: ""; width: 60px; height: 1px; background: var(--t-soft); }
  .orn i { width: 5px; height: 5px; border-radius: 50%; background: var(--t-soft); }

  .center { text-align: center; }
  .intro { max-width: 560px; margin: 0 auto; }
  .compact { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--t-line); border: 1px solid var(--t-line); margin-top: 8px; }
  .compact div { background: var(--t-bg); padding: 22px 14px; text-align: center; font: 500 19px/1.25 var(--f-title); }
  .compact span { display: block; font: 400 12px var(--f-body); letter-spacing: .2em; color: var(--t-accent); margin-bottom: 6px; }
  .note { margin-top: 26px; font-size: 15px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; margin-top: 40px; text-align: left; }
  .card { background: var(--t-panel); border: 1px solid var(--t-line); padding: 24px 22px; border-radius: 2px; }
  .card .n { font: 600 30px/1 var(--f-title); color: var(--t-accent); }
  .card h3 { font: 500 14px/1.4 var(--f-body); letter-spacing: .06em; text-transform: uppercase; margin: 12px 0 6px; }
  .card p { font-size: 15px; color: var(--t-soft); line-height: 1.55; }

  .resource { display: grid; grid-template-columns: 1fr auto; gap: 28px; align-items: center; background: var(--t-panel); border: 1px solid var(--t-line); padding: 34px 36px; border-radius: 2px; }
  .resource h3 { font: 500 26px var(--f-title); color: var(--t-heading); }
  .resource p { color: var(--t-soft); font-size: 16px; margin-top: 4px; }

  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px; }
  .quote { border-left: 1px solid var(--t-accent); padding: 4px 0 4px 22px; }
  .quote blockquote { font: italic 400 21px/1.45 var(--f-title); }
  .quote figcaption { margin-top: 14px; font-size: 15px; color: var(--t-text); font-weight: 500; }
  .stars { color: var(--t-accent); letter-spacing: .12em; font-size: 15px; margin-bottom: 8px; }
  .r-title { font-size: 13px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--t-soft); margin-bottom: 10px; }
  .r-meta { display: block; font-size: 13px; font-weight: 400; color: var(--t-soft); margin-top: 2px; }
  .r-link { display: inline-block; margin-top: 8px; font-size: 13px; font-weight: 400; color: var(--t-accent); text-decoration: none; }
  .r-full { margin-top: 14px; border: 0; padding: 0; }
  .r-full summary { font-size: 14px; color: var(--t-accent); }
  .r-full .prose { margin-top: 12px; font-size: 15px; }

  .authors { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; }
  .author { display: grid; grid-template-columns: 110px 1fr; gap: 26px; align-items: start; }
  :global(.author-photo) { width: 110px; height: 110px; border-radius: 50%; }
  .t-noir-gold :global(.author-photo) { background: #E9E1CC; }
  .author h3 { font: 600 26px/1.2 var(--f-title); color: var(--t-heading); margin-bottom: 6px; }
  .author p { font-size: 16px; }
  .more { display: inline-block; margin-top: 10px; font-size: 14px; color: var(--t-accent); text-decoration: none; }
  .ask { margin-top: 22px; font-size: 15px; }
  .ask a { color: var(--t-accent); }

  .follow { padding: 48px 0; border-top: 1px solid var(--t-line); }
  .follow .wrap { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .follow-label { font: 500 26px/1.2 var(--f-title); color: var(--t-heading); }
  .follow-links { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 820px) { .follow .wrap { flex-direction: column; text-align: center; } .follow-links { justify-content: center; } }
  .fine { padding: 34px 28px 50px; border-top: 1px solid var(--t-line); font-size: 13px; color: var(--t-soft); text-align: center; opacity: .85; }
  .fine p { max-width: 720px; margin: 0 auto; }

  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; padding-top: 48px; padding-bottom: 56px; text-align: center; }
    :global(.cover) { max-width: 230px; margin: 0 auto; }
    .hero-grid .btn-row, .signed { justify-content: center; }
    .art { width: 420px; opacity: .18; }
    .compact { grid-template-columns: repeat(2, 1fr); }
    .resource { grid-template-columns: 1fr; padding: 28px 24px; }
    .author { grid-template-columns: 84px 1fr; gap: 18px; }
    :global(.author-photo) { width: 84px; height: 84px; }
  }
</style>
