---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import BookBand from '../components/BookBand.astro';
import DeskSection from '../components/DeskSection.astro';
import { url } from '../lib/utils';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Ankit Jain', jobTitle: 'Author',
  url: Astro.site?.toString(),
};
---
<Base jsonLd={jsonLd}>
  <section class="wrap hero">
    <div>
      <div class="eyebrow">Author · Consultant · Learner</div>
      <h1 class="display">Making complex things <em>simple.</em></h1>
      <p class="lead">Two decades of solving problems in consulting taught me to look for patterns. Now I write about them: in the markets, in the mind, and in everyday life.</p>
      <div class="links"><a class="text-link" href="#books">See the books</a><a class="text-link" href={url('/about')}>About me</a></div>
    </div>
    <Photo file="ankit-jain.jpeg" alt="Ankit Jain" initials="AJ" class="hero-photo" eager />
  </section>

  <div id="books">
    {books.map((b, i) => <BookBand book={b} flip={i % 2 === 1} />)}
  </div>

  <DeskSection />
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.25fr .75fr; gap: 56px; align-items: center; padding-top: 96px; padding-bottom: 104px; }
  .display { margin: 18px 0 26px; }
  .lead { max-width: 520px; }
  .links { margin-top: 34px; display: flex; gap: 24px; font-size: 15px; }
  :global(.hero-photo) { aspect-ratio: 4/5; border-radius: 2px; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; gap: 40px; padding-top: 52px; padding-bottom: 64px; }
    :global(.hero-photo) { max-width: 320px; }
  }
</style>
