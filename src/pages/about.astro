---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { url } from '../lib/utils';

const authors = (await getCollection('authors')).sort((a, b) => a.data.order - b.data.order);
const main = authors.find((a) => a.data.isMain)!;
const coAuthors = authors.filter((a) => !a.data.isMain);
const { Content: MainBio } = await render(main);
const coBios = await Promise.all(coAuthors.map(async (a) => ({ a, Content: (await render(a)).Content })));
---
<Base title="About" description="About Ankit Jain: consultant, author and lifelong learner.">
  <section class="wrap about" id={main.id}>
    <Photo file={main.data.photo} alt={main.data.name} initials={main.data.initials} class="about-photo" eager />
    <div>
      <div class="eyebrow">About</div>
      <h1 class="display">Hello, I'm {main.data.name.split(' ')[0]}.</h1>
      <div class="prose bio"><MainBio /></div>
      <div class="links"><a class="text-link" href={url('/books')}>See my books</a><a class="text-link" href={url('/contact')}>Get in touch</a></div>
    </div>
  </section>

  {coBios.length > 0 && (
    <section class="block">
      <div class="wrap">
        <div class="eyebrow">Co-authors</div>
        {coBios.map(({ a, Content }) => (
          <div class="co" id={a.id}>
            <Photo file={a.data.photo} alt={a.data.name} initials={a.data.initials} class="co-photo" />
            <div>
              <h2 class="h2">{a.data.name}</h2>
              <div class="prose"><Content /></div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .about { display: grid; grid-template-columns: .75fr 1.25fr; gap: 64px; align-items: start; padding-top: 88px; padding-bottom: 96px; }
  :global(.about-photo) { aspect-ratio: 4/5; position: sticky; top: 100px; }
  .display { margin: 14px 0 28px; font-size: clamp(40px, 5vw, 64px); }
  .bio { max-width: 620px; }
  .links { margin-top: 34px; display: flex; gap: 24px; font-size: 15px; }
  .co { display: grid; grid-template-columns: 180px 1fr; gap: 48px; align-items: start; margin-top: 28px; }
  :global(.co-photo) { width: 180px; height: 180px; border-radius: 50%; }
  .co .prose { max-width: 680px; }
  @media (max-width: 820px) {
    .about { grid-template-columns: 1fr; gap: 36px; padding-top: 48px; padding-bottom: 64px; }
    :global(.about-photo) { position: static; max-width: 300px; }
    .co { grid-template-columns: 1fr; gap: 24px; }
    :global(.co-photo) { width: 140px; height: 140px; }
  }
</style>
