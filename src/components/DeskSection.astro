---
import NotifyForm from './NotifyForm.astro';
interface Props { title?: string; text?: string }
const { title = "What's next on my desk", text = "A new book is taking shape. I'll email you once when it's out. Nothing else." } = Astro.props;
---
<section class="desk">
  <div class="wrap">
    <div><h2 class="h2-display">{title}</h2><p class="muted">{text}</p></div>
    <NotifyForm />
  </div>
</section>
<style>
  .desk { padding: 100px 0; border-top: 1px solid var(--t-line); }
  .desk .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: end; }
  .desk h2 { margin-bottom: 0; }
  .desk p { margin-top: 14px; }
  @media (max-width: 820px) { .desk { padding: 64px 0; } .desk .wrap { grid-template-columns: 1fr; gap: 28px; } }
</style>
